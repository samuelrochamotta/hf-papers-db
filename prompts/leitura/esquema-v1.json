      ]
     },
     "estado": {
      "type": "string",
      "enum": [
       "liberado",
       "prometido",
       "so_pagina",
       "ausente"
      ]
     },
     "url": {
      "type": [
       "string",
       "null"
      ],
      "maxLength": 200
     },
     "licenca": {
      "type": [
       "string",
       "null"
      ],
      "maxLength": 40
     },
     "trecho": {
      "$ref": "#/$defs/trecho"
     }
    },
    "required": [
     "tipo",
     "estado",
     "url",
     "licenca",
     "trecho"
    ]
   },
   "maxItems": 6
  },
  "envelope": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "idiomas": {
     "type": "array",
     "items": {
      "type": "string",
      "maxLength": 5
     },
     "maxItems": 12,
