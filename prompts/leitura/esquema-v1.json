    },
    "dominio_treino": {
     "type": [
      "string",
      "null"
     ],
     "maxLength": 60
    }
   },
   "required": [
    "idiomas",
    "dominio_treino"
   ]
  },
  "nao_extraivel": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
     "local": {
      "type": "string",
      "maxLength": 40
     },
     "motivo": {
      "type": "string",
      "enum": [
       "so_em_figura",
       "tabela_icones",
       "tabela_multinivel"
      ]
     }
    },
    "required": [
     "local",
     "motivo"
    ]
   },
   "maxItems": 5
  }
 },
 "required": [
  "id",
  "titulo",
  "leitura",
  "entrega",
  "camada",
  "problema",
  "afiliacoes",
  "entidades",
  "relacoes",
  "resultados",
  "efeitos_custo",
  "hardware",
  "compute_declarado",
  "escala",
  "estatistica",
  "evidencia",
  "alegacoes",
  "ressalvas",
  "artefatos",
  "envelope",
  "nao_extraivel"
 ]
}